// config/env.js.example - 环境变量配置模板
// 暴风战斧AI视频生成系统 (Stormaxe AI Video System)
// 
// 使用说明：
// 1. 复制此文件为 config/env.js
// 2. 填入你的实际 API Key 和接入点
// 3. 确保 config/env.js 在 .gitignore 中，不要提交到 GitHub

const ENV = {
  // 火山引擎 API Key（从火山方舟控制台获取）
  ARK_API_KEY: process.env.ARK_API_KEY || 'YOUR_API_KEY_HERE',
  
  // 火山引擎 API 基础 URL
  ARK_BASE_URL: process.env.ARK_BASE_URL || 'https://ark.cn-beijing.volces.com/api/v3',
  
  // Seedance 2.0 视频生成模型接入点
  SEEDANCE_ENDPOINT: process.env.SEEDANCE_ENDPOINT || 'YOUR_SEEDANCE_ENDPOINT_HERE',
  SEEDANCE_FAST_ENDPOINT: process.env.SEEDANCE_FAST_ENDPOINT || 'YOUR_SEEDANCE_FAST_ENDPOINT_HERE',
  
  // Seedream 5.0 lite 图片生成模型接入点
  SEEDREAM_ENDPOINT: process.env.SEEDREAM_ENDPOINT || 'YOUR_SEEDREAM_ENDPOINT_HERE',
  
  // Kimi API 配置（使用 OpenClaw 自带模型时无需修改）
  KIMI_API_KEY: process.env.KIMI_API_KEY || 'openclaw-internal',
  KIMI_MODEL: process.env.KIMI_MODEL || 'kimi-k2p6',
  KIMI_BASE_URL: process.env.KIMI_BASE_URL || 'https://api.moonshot.cn/v1',
  
  // 模型 ID 映射（预置推理）
  MODEL_IDS: {
    SEEDANCE_2_0: 'doubao-seedance-2-0-260128',
    SEEDANCE_2_0_FAST: 'doubao-seedance-2-0-fast-260128',
    SEEDREAM_5_0_LITE: 'doubao-seedream-5-0-260128'
  },
  
  // 默认生成参数
  DEFAULT_VIDEO_RATIO: '16:9',
  DEFAULT_VIDEO_DURATION: 11,
  DEFAULT_IMAGE_SIZE: '2K',
  
  // 项目信息
  PROJECT: 'default',
  CREATED_BY: 'your-name'
};

// 环境检测
ENV.isProduction = process.env.NODE_ENV === 'production';
ENV.isDevelopment = process.env.NODE_ENV === 'development' || !ENV.isProduction;

module.exports = ENV;
