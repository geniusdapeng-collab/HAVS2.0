    const checks = {
      color: { passed: true, issues: [] },
      features: { passed: true, issues: [] },
      scale: { passed: true, issues: [] }
    };
    
    // 颜色一致性
    const colorChecks = [
      { key: beast.color.primary, name: '主色' },
      { key: beast.color.secondary, name: '辅色' },
      { key: beast.color.accent, name: '强调色' }
