            beforeMarkers++;
            beforeShots.push(`${shot.id}: ${kw}`);
          } else {
            // 后半场出现"前"状态词，可能是回退，扣少量分
            evidence.push(`${shot.id}: 后半场出现退缩状态「${kw}」-3`);
