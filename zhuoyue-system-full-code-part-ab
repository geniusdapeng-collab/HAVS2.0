    }
    
    const chineseMap = {
      '一': 1, '二': 2, '两': 2, '三': 3, '四': 4, '五': 5,
      '六': 6, '七': 7, '八': 8, '九': 9, '十': 10,
      '百': 100, '千': 1000, '万': 10000, '亿': 100000000
    };
    
    let result = 0;
    let temp = 0;
    let lastUnit = 1;
    
    for (let i = 0; i < str.length; i++) {
      const char = str[i];
      const value = chineseMap[char];
      
      if (value === undefined) continue;
      
      if (value >= 10) {
        // 单位词（十、百、千等）
        if (temp === 0) temp = 1;
        result += temp * value;
        temp = 0;
        lastUnit = value;
