    };
    
    // 运镜方向向量映射（简化三维向量）
    this.CAMERA_VECTORS = {
      'push_in':    { x: 0, y: 0, z: 1 },    // 推向主体
      'pull_out':   { x: 0, y: 0, z: -1 },   // 拉远
      'pan_left':   { x: -1, y: 0, z: 0 },   // 左摇
      'pan_right':  { x: 1, y: 0, z: 0 },    // 右摇
      'tilt_up':    { x: 0, y: 1, z: 0 },     // 上摇
      'tilt_down':  { x: 0, y: -1, z: 0 },    // 下摇
      'truck_left': { x: -1, y: 0, z: 0 },   // 左移
      'truck_right':{ x: 1, y: 0, z: 0 },    // 右移
