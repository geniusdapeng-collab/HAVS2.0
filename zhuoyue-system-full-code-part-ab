    };
    
    let beforeMarkers = 0;
    let afterMarkers = 0;
    let beforeShots = [];
    let afterShots = [];
    
    // 按时间顺序分析
    const midPoint = Math.floor(shots.length / 2);
    
    for (let i = 0; i < shots.length; i++) {
      const shot = shots[i];
      const text = (shot.prompt || '') + ' ' + (shot.visualPrompt || '') + ' ' + (shot.narration || '') + ' ' + (shot.action || '');  // 🔥 v6.2-patch51-fix: 检查所有字段并集
      const isBefore = i < midPoint;
      
