    // 简单策略：截断到maxLen字符，找最近的标点
    let trimmed = text.substring(0, maxLen);
    const lastPunct = Math.max(
      trimmed.lastIndexOf('，'),
      trimmed.lastIndexOf('。'),
      trimmed.lastIndexOf('、')
