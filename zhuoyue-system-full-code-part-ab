  if (output === null || output === undefined) {
    issues.push('output is null/undefined');
    return { valid: false, issues, score: 0 };
  }

  if (typeof output === 'string') {
    const text = output.trim();
    if (!text) {
      issues.push('output string is empty');
    } else {
