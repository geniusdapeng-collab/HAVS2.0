      ],
      // 情绪密度阈值（每100字符中至少出现N个情绪词）
      emotionDensityThreshold: 2,
      // 最大注入次数
      maxInjectionsPerShot: 3,
      // 注入位置标记
      injectMarkers: ['【视觉】', '【环境布景】', '【技术规格】'],
