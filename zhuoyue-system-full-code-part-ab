Director Style: ${blend.directors.map(d => d.name.split(' ')[0]).join(' + ')} fusion
${topTags.join(', ')}, ${topColors.join('/')} palette,
${topLighting.join(', ')} lighting,
${topMood.join(' + ')} atmosphere,
电影级大片品质
    `.trim().replace(/\n/g, ' ').replace(/\s+/g, ' ');
    
