    const selection = this.selector.selectPack(sceneParams);
    const topPack = selection.topPick.pack;
    
    // 2. 生成一镜到底镜头定义
    const oneShot = {
      type: 'one-shot',
      name: `${topPack.name} — 一镜到底`,
