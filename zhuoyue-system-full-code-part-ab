    if (sceneType === 'climax' || sceneType === 'reveal') {
      parts.push(`Abilities: ${beast.abilities.join(', ')}.`);
    }
    
    // 栖息地
    if (beast.habitat) {
      parts.push(`Habitat: ${beast.habitat}.`);
    }
    
