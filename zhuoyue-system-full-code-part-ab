    if (emotionDensity < this.config.emotionDensityThreshold) {
      const emotionInjection = this.injectEmotionKeywords(prompt, shot);
      if (emotionInjection.success) {
        prompt = emotionInjection.prompt;
        injections++;
        this.boosterLog.push({
