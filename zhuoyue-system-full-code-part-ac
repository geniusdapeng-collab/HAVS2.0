  return {
    valid: errors.length === 0,
    errors,
    warnings,
    stats: {
      requiredCharacters: requiredChars.length,
      shotsWithCharacters: shotsWithRef + shotsWithoutRef,
      shotsWithRef,
      shotsWithoutRef
    }
  };
}

