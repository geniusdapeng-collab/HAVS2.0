  measureActualDurations(shots, shotsDir) {
    const durations = [];
    
    for (const shot of shots) {
      const videoPath = path.join(shotsDir, `${shot.id}.mp4`);
      if (!fss.existsSync(videoPath)) {
        console.warn(`⚠️ 视频不存在: ${shot.id}`);
