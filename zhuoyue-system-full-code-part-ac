      }
    };

    // 类型推断关键词（从原文提取）
    this.TYPE_KEYWORDS = {
      'sacred': ['祥瑞', '神圣', '通灵', '洁白', '金色', '九尾', '凤', '麟', '泽', '吉', '瑞', '仙'],
      'ferocious': ['食人', '凶', '恶', '饕餮', '穷奇', '梼杌', '混沌', '吞噬', '贪婪', '残忍', '暴'],
