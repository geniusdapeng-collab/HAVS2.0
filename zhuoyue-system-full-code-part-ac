      shot.visualPrompt || '',
      shot.prompt || ''
    ].join(' ');
    
    let count = 0;
    const foundKeywords = [];
    
    for (const action of this.config.initiativeActions) {
      if (texts.includes(action)) {
        count++;
        foundKeywords.push(action);
      }
    }
    
    return { count, foundKeywords };
