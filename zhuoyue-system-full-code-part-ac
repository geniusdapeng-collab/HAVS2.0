      '通用': ['环境风声', '动作摩擦声', '生物活动声', '自然氛围音']
    };

    const elements = soundMap[environment] || soundMap['通用'];

    return {
      type: 'Diegetic',
      rule: this.diegeticRule.name,
      elements,
      noMusic: true,
      noNarration: true,
      environment,
      appliedTo: shot.id || 'unknown',
      generatedAt: new Date().toISOString()
    };
  }

  /**
   * 验证音效是否符合铁律
