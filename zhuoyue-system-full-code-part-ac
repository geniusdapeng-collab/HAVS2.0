    const phase = promptData.emotionPhase || 'neutral';
    
    const validExpressions = this.emotionExpressionMap[phase] || [];
    if (validExpressions.length === 0) {
      return {
        dimension: '情绪-表情一致性',
        score: 70,
        weight: this.weights.emotionConsistency,
        comment: '未定义情绪阶段，默认评分'
