      case 'interaction':
        return '嘴部张开正在对话互动,表情生动,眼神交流自然';
      case 'demonstration':
        return '嘴部配合动作进行讲解,呼吸自然,偶尔抿嘴思考';
      case 'climax':
        return '嘴部张大正在激动陈述,表情强烈,情绪饱满';
      case 'closing':
        return '嘴部微笑总结发言,语速放缓,眼神温和';
