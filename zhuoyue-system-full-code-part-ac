    if (!sound.noNarration) {
      issues.push('违反铁律：检测到旁白');
    }

    if (sound.type !== 'Diegetic') {
      issues.push('违反铁律：音效类型必须为Diegetic');
    }

    return {
      valid: issues.length === 0,
      issues,
      rule: this.diegeticRule.name
    };
  }

