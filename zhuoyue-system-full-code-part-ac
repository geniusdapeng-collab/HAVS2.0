  const errors = [];
  const warnings = [];
  
  // 1. 收集必需角色
  const requiredChars = options.requiredCharacters || storyboard.requiredCharacters || [];
  const characters = options.characters || storyboard.characters || {};
  
  if (requiredChars.length === 0) {
    // 无必需角色配置，跳过（通用项目不强制）
    return { valid: true, errors, warnings };
