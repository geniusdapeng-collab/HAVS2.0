{
  "type": "object",
  "required": ["title", "topic", "keyPoints", "targetDuration", "scenes", "characters", "world", "style", "meta"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "videoType": { "type": "string" },
    "targetAudience": { "type": "string" },
    "platform": { "type": "string" },
    "targetDuration": { "type": "number", "minimum": 1 },
    "aspectRatio": { "type": "string" },
    "visualStyle": { "type": "string" },
    "qualityLevel": { "type": "string" },
    "colorTone": { "type": "string" },
    "creativityIndex": { "type": "number", "minimum": 0, "maximum": 1 },
    "narrativeStyle": { "type": "string" },
    "contentStyle": { "type": "string" },
    "visualStyleDetail": { "type": "string" },
    "musicStyle": { "type": "string" },
    "characters": { "type": "object" },
    "scenes": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
    "opening": { "type": "object" },
    "ending": { "type": "object" },
    "keyPoints": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "isSeries": { "type": "boolean" },
    "totalEpisodes": { "type": "number" },
    "currentEpisode": { "type": "number" },
    "episodeThemes": { "type": "array", "items": { "type": "string" } },
    "contentIsolation": { "type": "string" },
    "world": { "type": "object" },
    "style": { "type": "object" },
    "constraints": { "type": "object" },
    "meta": { "type": "object" }
  }
}
