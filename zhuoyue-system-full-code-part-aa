          const color = v.detail.match(/"([^"]+)"/)?.[1];
          if (color) {
            const replacement = v.expected?.match(/应使用: (.+)/)?.[1]?.split('/')?.[0] || '';
            fixed = fixed.replace(new RegExp(color, 'g'), replacement);
          }
        }
      }
    }
    
    return fixed;
