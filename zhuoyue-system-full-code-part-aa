    ];
    
    const results = [];
    for (const test of cases) {
      const result = this.parse(test.input);
      const passed = Math.abs(result.value - test.expected) < 0.05;
      results.push({
        input: test.input,
        expected: test.expected,
        actual: result.value,
        passed,
        source: result.source,
        desc: test.desc
      });
    }
    
    return results;
  }
