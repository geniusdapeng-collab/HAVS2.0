  /**
   * 辅助:计算 narration 容量(基于时长)
   */
  calculateNarrationCapacity(duration) {
    const SPEECH_RATE = 5.0; // 字/秒(讲解语速)
    const BUFFER = 2; // 缓冲字数
    return Math.floor(duration * SPEECH_RATE - BUFFER);
  }

