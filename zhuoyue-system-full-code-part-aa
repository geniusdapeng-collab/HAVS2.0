  enhancePromptWithAdventure(prompt, markers) {
    if (!prompt || markers.length === 0) return prompt;
    
    // 检查是否已含冒险标记
    const hasAdventure = markers.some(m => prompt.includes(m));
    if (hasAdventure) return prompt; // 已有则不加，避免重复
    
    // 在Prompt末尾追加冒险氛围（技术规格区之前）
