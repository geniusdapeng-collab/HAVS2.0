    }
  ],
  "narrative": {
    "emotion": "neutral",
    "pace": "medium",
    "totalDuration": 12
  },
  "world": {
    "name": "${world.name || 'Nirath'}",
    "setting": "${world.setting || ''}"
  }
}`);

    return parts.join('\n');
  }

