    const atmosUpgradeBudget = Math.min(Math.floor(remainingBudget * 0.8), 100);
    if (atmosUpgradeBudget > 20) {
      let atmosUpgrade = this.upgradeAtmosphere(analysis, type, atmosUpgradeBudget);
      if (atmosUpgrade && styleConstraint) {
