  const registry = getRegistry();
  const prd = registry[codename];
  if (!prd) {
    throw new Error(`未知主题代号: ${codename}. 可用: ${Object.keys(registry).join(', ')}`);
  }
  return prd;
}

/**
 * 列出所有可用主题
 * @returns {Array} 主题列表
 */
