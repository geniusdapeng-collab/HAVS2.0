  // v24.2保留:Prompt余量回收与智能升级系统
  upgradePromptWithDeficit({ prompt, analysis, deficit, type, script, characters, emotionPhase, sceneDNA, styleConstraint }) {
    // ... 现有逻辑保持不变 ...
    let upgradedPrompt = prompt;
