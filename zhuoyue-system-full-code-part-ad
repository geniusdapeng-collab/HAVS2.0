    const weights = { FATAL: 50, CRITICAL: 25, WARNING: 10, INFO: 2 };
    const totalDeduction = deviations.reduce((sum, d) => {
      return sum + (weights[d.severity] || 0);
    }, 0);
    return Math.max(0, 100 - totalDeduction / Math.max(1, totalShots));
  }
}

