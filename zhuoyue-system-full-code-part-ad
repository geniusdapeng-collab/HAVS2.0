      if (cleanedMouthAction.length > 0) {
        prompt += ` 【嘴部动作】${cleanedMouthAction}`;
        console.log(`[Core-v24.3] 🎙️ 嘴部动作注入: ${cleanedMouthAction.length}字符 | 视觉指令`);
