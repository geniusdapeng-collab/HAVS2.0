    this.emotionExpressionMap = {
      'establishing': {
        facial: ['neutral relaxed expression', 'soft gentle gaze', 'natural breathing rhythm'],
        body: ['relaxed shoulders', 'open posture', 'natural stance'],
        mouth: ['lips gently closed', 'soft neutral mouth'],
