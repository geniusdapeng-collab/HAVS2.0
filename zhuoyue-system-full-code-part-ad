  _validateCoreTheme(episodePlan) {
    const content = JSON.stringify(episodePlan);
    const theme = this.config.narrativeTone.coreTheme;
    
    if (!content.includes('记忆即存在') && !content.includes('看见即救赎')) {
      this.issues.push({
