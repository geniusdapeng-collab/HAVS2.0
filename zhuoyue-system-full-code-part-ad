      let cleanedMouthAction = mouthAction.replace(/[""""].*?[""""]/g, '').replace(/[一-龥]{5,}/g, '').trim();
      
      // v6.2-patch103-fix: 标准化嘴部动作映射（统一英文关键词为中文描述）
      const mouthActionMap = {
