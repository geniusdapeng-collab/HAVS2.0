    if (ad.materials && ad.materials.length > 0) score += 15;
    if (ad.cinematicInstructions && ad.cinematicInstructions.length > 0) score += 15;
    return Math.min(100, score);
  }
  
  scorePrompt(pr) {
    let score = 0;
