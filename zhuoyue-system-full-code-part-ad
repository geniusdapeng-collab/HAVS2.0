      }
    );

    if (!res.ok) {
      const err = await res.text();
      throw new Error(`图片生成任务提交失败: ${res.status} ${err}`);
    }

    const data = await res.json();
    console.log(`[VolcengineArkClient] 图片生成成功`);
    
